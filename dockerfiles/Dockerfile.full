FROM --platform=amd64 regproxy.ornl.gov/hub_proxy/python:3.10 AS system

RUN apt-get update \
   && apt-get install -y ffmpeg libldap2-dev libsasl2-dev \
   && rm -rf /var/lib/apt/lists/*

# The chart's fsGroup expects this gid; -r alone picks one based on the installed packages.
RUN groupadd -r -g 994 galaxy \
   && useradd -r -m -u 1000 -g galaxy galaxy \
   && mkdir /galaxy \
   && chown galaxy:galaxy /galaxy

# Build stage: nothing here reaches the final image unless it is copied out below.
FROM system AS build

RUN apt-get update && apt-get install -y nodejs npm \
   && corepack enable \
   && corepack prepare pnpm@10.26.1 --activate \
   && rm -rf /var/lib/apt/lists/*

WORKDIR /galaxy

# copy files
COPY --chown=galaxy:galaxy . /galaxy

USER galaxy

# .dockerignore.full excludes .git so common_startup.sh skips the dev wheels; run_tests.sh
# installs them itself. Runtime packages that only the dev wheels used to provide are
# installed below: ase (CIF/XYZ metadata), pkce (OIDC login) and watchdog (watch_tools).
RUN NODE_OPTIONS=--max-old-space-size=8192 /galaxy/scripts/common_startup.sh
RUN . /galaxy/.venv/bin/activate \
   && pip install python-ldap==3.4.8 rucio-clients==40.2.0 \
   && pip install -c lib/galaxy/dependencies/dev-requirements.txt ase pkce watchdog

# Final image: only generated artifacts. The source tree comes from dockerfiles/Dockerfile.
FROM system

WORKDIR /galaxy

# Tools run in containers on k8s or Pulsar, so Galaxy needs no conda of its own. Without
# this, run.sh and Galaxy would download Miniforge on every start.
ENV GALAXY_CONFIG_CONDA_AUTO_INIT=false

COPY --from=build --chown=galaxy:galaxy /galaxy/.venv /galaxy/.venv
COPY --from=build --chown=galaxy:galaxy /galaxy/static /galaxy/static
COPY --from=build --chown=galaxy:galaxy /galaxy/lib/galaxy/web/framework/meta.json /galaxy/lib/galaxy/web/framework/meta.json

USER galaxy

# manage_tool_dependencies.py crashes at startup if this is missing, even with auto init off.
RUN mkdir -p /galaxy/database/dependencies
